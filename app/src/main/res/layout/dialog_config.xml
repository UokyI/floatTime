<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_card_bg"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/adv_view_config"
        android:textColor="#222222"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:background="#FFF5F5F7"
        android:padding="14dp">

        <TextView
            android:id="@+id/configText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#333333"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:lineSpacingExtra="3dp" />

    </ScrollView>

    <!-- 第一行：复制 + 粘贴 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="18dp">

        <Button
            android:id="@+id/btnCopy"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/btn_copy"
            android:textSize="15sp"
            android:textColor="#1F6FEB"
            android:textStyle="bold"
            android:background="@drawable/btn_primary_bg"
            android:layout_marginEnd="8dp"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnPaste"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/btn_paste"
            android:textSize="15sp"
            android:textColor="#1F6FEB"
            android:textStyle="bold"
            android:background="@drawable/btn_primary_bg"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:textAllCaps="false" />

    </LinearLayout>

    <!-- 第二行：重置 + 关闭 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="10dp">

        <Button
            android:id="@+id/btnReset"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/adv_reset"
            android:textSize="15sp"
            android:textColor="#E53935"
            android:textStyle="bold"
            android:background="@drawable/btn_danger_bg"
            android:layout_marginEnd="8dp"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnConfigClose"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/btn_config_close"
            android:textSize="15sp"
            android:textColor="#888888"
            android:textStyle="bold"
            android:background="@drawable/btn_neutral_bg"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:textAllCaps="false" />

    </LinearLayout>

</LinearLayout>
