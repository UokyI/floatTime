<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/page_config_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:layout_marginBottom="24dp" />

        <!-- 空闲色 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_idle_color"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="22dp">

            <View
                android:id="@+id/swatchIdle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/swatch_bg" />

            <Button
                android:id="@+id/btnIdleColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_pick_color"
                android:layout_marginStart="16dp"
                android:minWidth="0dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp" />
        </LinearLayout>

        <!-- 进行色 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_active_color"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="22dp">

            <View
                android:id="@+id/swatchActive"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/swatch_bg" />

            <Button
                android:id="@+id/btnActiveColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_pick_color"
                android:layout_marginStart="16dp"
                android:minWidth="0dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp" />
        </LinearLayout>

        <!-- 直径 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_ball_size"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <SeekBar
                android:id="@+id/seekSize"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="240" />

            <TextView
                android:id="@+id/textSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="160dp"
                android:textSize="14sp"
                android:layout_marginStart="12dp"
                android:minWidth="64dp" />
        </LinearLayout>

        <!-- 字体大小 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_text_size"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <SeekBar
                android:id="@+id/seekTextSize"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="40" />

            <TextView
                android:id="@+id/textTextSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="22sp"
                android:textSize="14sp"
                android:layout_marginStart="12dp"
                android:minWidth="64dp" />
        </LinearLayout>

        <!-- 语言 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_language"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="10dp" />

        <RadioGroup
            android:id="@+id/langGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/langSystem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lang_system" />

            <RadioButton
                android:id="@+id/langZh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lang_zh" />

            <RadioButton
                android:id="@+id/langEn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lang_en" />
        </RadioGroup>

    </LinearLayout>

</ScrollView>
