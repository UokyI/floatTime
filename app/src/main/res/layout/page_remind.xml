<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/page_remind_title"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#222222"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/remind_desc"
        android:textSize="14sp"
        android:textColor="#999999"
        android:layout_marginBottom="28dp" />

    <RadioGroup
        android:id="@+id/remindGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/remindSilent"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/remind_silent"
            android:textSize="16sp"
            android:textColor="#333333"
            android:paddingStart="16dp" />

        <RadioButton
            android:id="@+id/remindVibrate"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/remind_vibrate"
            android:textSize="16sp"
            android:textColor="#333333"
            android:paddingStart="16dp" />

        <RadioButton
            android:id="@+id/remindLight"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/remind_light"
            android:textSize="16sp"
            android:textColor="#333333"
            android:paddingStart="16dp" />

        <RadioButton
            android:id="@+id/remindStorm"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/remind_storm"
            android:textSize="16sp"
            android:textColor="#333333"
            android:paddingStart="16dp" />

    </RadioGroup>

</LinearLayout>
